{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "data/**",
        "models/**",
        "eda/**",
        "recommendations/**",
        "backend/**",
        "ml/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ]
}
